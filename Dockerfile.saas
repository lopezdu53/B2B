# Build stage
FROM golang:1.26.4-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git ca-certificates

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the gmapssaas binary (stripped and optimized)
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /gmapssaas ./cmd/gmapssaas

# Playwright stage - assemble the playwright-go driver from the official npm
# package and download Chromium with the official client.
#
# Why: the pinned playwright-go (v0.5700.1, CLI 1.57.0) downloads its driver
# from the retired playwright.azureedge.net CDN, which now returns 404/400. The
# npm "playwright" package IS that driver's runtime, so we assemble the driver
# directory from npm (no dead CDN) and let the official Node client fetch the
# browser (it uses the current mirrors with proper fallback). Everything is
# baked into the image so the worker never downloads anything at runtime.
FROM node:20-bookworm-slim AS playwright

# Must match playwright-go's pinned CLI version (playwrightCliVersion).
ENV PW_VERSION=1.57.0
ENV PW_DRIVER_DIR=/opt/ms-playwright-go/1.57.0
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/browsers

WORKDIR /pw
RUN npm install playwright@${PW_VERSION} --no-audit --no-fund \
    # Lay the driver out exactly how playwright-go expects it:
    #   $PW_DRIVER_DIR/package/cli.js  and  a resolvable playwright-core.
    && mkdir -p "${PW_DRIVER_DIR}/package/node_modules" \
    && cp -r node_modules/playwright/. "${PW_DRIVER_DIR}/package/" \
    && cp -r node_modules/playwright-core "${PW_DRIVER_DIR}/package/node_modules/playwright-core" \
    # Sanity check + download Chromium via the official multi-mirror client.
    && node "${PW_DRIVER_DIR}/package/cli.js" --version \
    && node "${PW_DRIVER_DIR}/package/cli.js" install chromium

# Final stage - Debian slim with Playwright Chromium dependencies + Node runtime
FROM debian:bookworm-slim
LABEL org.opencontainers.image.source=https://github.com/gosom/google-maps-scraper

WORKDIR /app

# System libraries that Playwright's Chromium needs to run, plus the Node.js
# runtime used to drive it. Cleanup in the same layer to keep the image small.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libatspi2.0-0 \
    libx11-6 \
    libxext6 \
    libpango-1.0-0 \
    libcairo2 \
    fonts-liberation \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/* \
    && rm -rf /usr/share/doc /usr/share/man /usr/share/locale

# Point playwright-go at the baked driver, Node runtime and browsers so it never
# hits the network at runtime.
ENV PLAYWRIGHT_DRIVER_PATH=/opt/ms-playwright-go/1.57.0
ENV PLAYWRIGHT_NODEJS_PATH=/usr/bin/node
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/browsers

# Copy the assembled driver and the downloaded browser.
COPY --from=playwright /opt/ms-playwright-go /opt/ms-playwright-go
COPY --from=playwright /opt/browsers /opt/browsers

# Copy binary from builder
COPY --from=builder /gmapssaas /app/gmapssaas

# Copy migrations (needed for server mode)
COPY --from=builder /app/migrations /app/migrations

EXPOSE 8080

# Default to serve mode, can be overridden with "worker" argument
ENTRYPOINT ["/app/gmapssaas"]
CMD ["serve"]
